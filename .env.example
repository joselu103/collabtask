# .env.example

# Application data
APP_NAME=CollabTask     # Name of the app
APP_VERSION=0.0.1       # Version of the app
DEBUG=false             # Enable debug mode
HOST=localhost          # Host for the server
PORT=8000               # Port for the server
ALLOWED_ORIGINS=[*]     # Allowed origins for CORS

# Database settings
DATABASE_URL=""         # driver://user:password@service:port/database_name
# Database settings for DB container
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_DB=mydb

# Authentication
SECRET_KEY = ""                     # key used for JWT
ACCESS_TOKEN_EXPIRE_MINUTES = 30    # 
REFRESH_TOKEN_EXPIRE_DAYS = 7       #

# Redis
REDIS_URL=redis://<host>:<port>/<db>             

# Email:
SMTP_HOST=example               # Address of the SMTP service
SMTP_PORT=587                   # Port for the SMTP service
SMTP_USER=user                  # User for the SMTP service
SMTP_PASSWORD=password          # Password for the SMTP service
EMAIL_FROM=example              # Sender identification
SMTP_TLS=true                   # Enable TLS -> disable for mailpit test

# AWS:
ECR_URL=<account-id>.dkr.ecr.<region>.amazonaws.com/projects/collabtask:latest # Container URL